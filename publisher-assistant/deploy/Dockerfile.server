FROM mcr.microsoft.com/playwright:v1.61.1-noble

RUN apt-get -o Acquire::Retries=2 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg x11vnc novnc websockify \
    && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get -o Acquire::Retries=2 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=production \
    PUBLISHER_HOST=0.0.0.0 \
    PUBLISHER_PORT=19181 \
    BROWSER_HEADLESS=false \
    BROWSER_CHANNEL=chrome \
    PUBLISHER_AUTO_RUN=true

COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
COPY public ./public
COPY vendor ./vendor
COPY deploy/novnc-package.json /usr/share/novnc/package.json
COPY server.mjs ./server.mjs
COPY deploy/start-server.sh ./start-server.sh
RUN chmod +x ./start-server.sh

EXPOSE 19181 6080
CMD ["./start-server.sh"]
