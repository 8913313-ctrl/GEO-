FROM mcr.microsoft.com/playwright:v1.61.1-noble

WORKDIR /app
ENV NODE_ENV=production \
    PUBLISHER_HOST=0.0.0.0 \
    PUBLISHER_PORT=18181 \
    BROWSER_HEADLESS=true

COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
COPY public ./public
COPY server.mjs ./server.mjs

EXPOSE 18181
CMD ["node", "server.mjs"]
