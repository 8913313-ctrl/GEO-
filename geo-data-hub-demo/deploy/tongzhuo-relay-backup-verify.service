[Unit]
Description=Verify latest Tongzhuo relay backup and encrypted credentials
After=tongzhuo-relay-backup.service

[Service]
Type=oneshot
User=tongzhuo-relay
Group=tongzhuo-relay
WorkingDirectory=/srv/tongzhuo-relay/app
EnvironmentFile=/srv/tongzhuo-relay/.env
ExecStart=/usr/bin/node /srv/tongzhuo-relay/app/scripts/verify-relay-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/tongzhuo-relay/data /srv/tongzhuo-relay/backups
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal

