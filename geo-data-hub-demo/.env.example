# Central Tongzhuo relay configuration. Copy to .env and keep it out of Git.
NODE_ENV=production
# Keep the Node listener private. Docker overrides this to 0.0.0.0 inside its
# network namespace while publishing the port only to the host loopback.
HOST=127.0.0.1
PORT=44280

# Public HTTPS origin and the exact peer IP address(es) from which Node accepts
# X-Forwarded-* headers. Do not add public client networks here. For a host
# Nginx -> Docker deployment this is normally the Docker bridge gateway; verify
# it on the target host before start-up.
TZ_RELAY_PUBLIC_ORIGIN=https://relay.example.com
TZ_RELAY_TRUSTED_PROXY_ADDRESSES=127.0.0.1
TZ_RELAY_REQUIRE_HTTPS_FOR_ADMIN=1
# Path to the rendered, placeholder-free Nginx configuration used by
# `npm run ops:preflight`. Generate it with `npm run ops:render-nginx`.
TZ_RELAY_NGINX_CONFIG=/etc/nginx/conf.d/tongzhuo-relay.conf

# Persistent data and encryption key. Prefer an external secret manager in production.
TZ_RELAY_DATA_DIR=/srv/tongzhuo-relay/data
TZ_RELAY_DATABASE_PATH=/srv/tongzhuo-relay/data/tongzhuo-relay.sqlite
TZ_RELAY_MASTER_KEY=
# Docker/Kubernetes secret-file alternatives. Set either *_KEY or *_KEY_FILE,
# never both. The master key must be a 32-byte base64/base64url/hex value.
# TZ_RELAY_MASTER_KEY_FILE=/run/secrets/tz_relay_master_key

# Central admin API. Required in production. The root token is for CLI use or
# one-time browser session exchange only; the console never persists it.
TZ_RELAY_ADMIN_TOKEN=
# TZ_RELAY_ADMIN_TOKEN_FILE=/run/secrets/tz_relay_admin_token
TZ_RELAY_ALLOW_INSECURE_ADMIN=0
# Browser operator sessions are opaque, HttpOnly and same-site. Production
# defaults are a one-hour TTL, a __Host- cookie and Secure=true; do not relax
# them on an Internet-facing deployment.
TZ_RELAY_ADMIN_SESSION_TTL_SECONDS=3600
TZ_RELAY_ADMIN_SESSION_COOKIE_NAME=__Host-tz-relay-admin-session
TZ_RELAY_ADMIN_SESSION_SECURE=1
TZ_RELAY_ADMIN_SESSION_RETENTION_DAYS=7

# Optional stdio MCP operations adapter. Set these only for the process that
# runs `npm run mcp:serve`; use HTTPS for a non-loopback central relay URL.
# TZ_RELAY_MCP_URL=https://relay.example.com
TZ_RELAY_MCP_TIMEOUT_MS=10000
# Secret rotation through MCP is disabled unless this pre-created, ACL-protected
# handoff directory is configured. The adapter never returns client secrets.
# TZ_RELAY_MCP_SECRET_HANDOFF_DIR=/srv/tongzhuo-relay/mcp-secret-handoff

# One shared AIDSO account. The token is encrypted into SQLite when saved through
# the admin API; AIDSO_TOKEN is optional when the database already has a token.
TZ_RELAY_AIDSO_MODE=real
AIDSO_TOKEN=
# AIDSO_TOKEN_FILE=/run/secrets/aidso_token
AIDSO_BASE_URL=https://openapi.aidso.com/geo_api
# Keep the shared AIDSO token on HTTPS. This override exists only for an
# approved private TLS-terminating test gateway and must never be enabled for
# public or ordinary production traffic.
TZ_RELAY_ALLOW_INSECURE_AIDSO_BASE_URL=0
AIDSO_TIMEOUT_MS=45000

# Worker and queue controls.
TZ_RELAY_WORKER_ENABLED=1
TZ_RELAY_WORKER_INTERVAL_MS=5000
TZ_RELAY_WORKER_CONCURRENCY=4
TZ_RELAY_WORKER_CLAIM_LIMIT=12
TZ_RELAY_POLL_INITIAL_DELAY_MS=15000
TZ_RELAY_POLL_RETRY_BASE_MS=15000
TZ_RELAY_SUBMIT_RETRY_BASE_MS=15000

# Operational retention. Billing ledger and run records are never purged by
# the built-in cleanup worker; only acknowledged/dead-letter deliveries, audit
# records and expired nonces are removed after these windows.
TZ_RELAY_CLEANUP_INTERVAL_MS=21600000
TZ_RELAY_DELIVERY_RETENTION_DAYS=90
TZ_RELAY_AUDIT_RETENTION_DAYS=365
# Raw AIDSO responses are retained only while a queued/leased delivery still
# needs them, then removed after this maximum period. The operator console may
# select a shorter value but can never extend this deployment ceiling.
TZ_RELAY_RAW_RESPONSE_RETENTION_DAYS=90
TZ_RELAY_BACKUP_DIR=/srv/tongzhuo-relay/backups
TZ_RELAY_BACKUP_RETENTION_DAYS=30

# Production must disable demo tenant seeding. Set to 1 only for local demos.
TZ_RELAY_SEED_DEMO=0
TZ_RELAY_ALLOW_MOCK_IN_PRODUCTION=0

# Run `npm run ops:check` from a trusted scheduler. The webhook, when used,
# receives only redacted availability and attention metadata.
# Point this at the HTTPS proxy URL accepted by the management allowlist. On a
# host scheduler, do not use a bare HTTP Node listener in production.
TZ_RELAY_URL=https://relay.example.com
TZ_RELAY_ALERT_ATTENTION_THRESHOLD=0
# TZ_RELAY_ALERT_WEBHOOK_URL=https://alerts.example.com/tongzhuo-relay
# If a webhook is not used, the scheduler/monitoring platform must alert on
# the non-zero exit status from ops:check. Preflight requires one of the two.
TZ_RELAY_ALERT_EXIT_MONITORED=1
# Structured JSON logs go to journald for systemd, or to the Docker log driver.
TZ_RELAY_LOG_SINK=journal
