# 单企业私有化部署配置
NODE_ENV=production
TZ_BIND_HOST=0.0.0.0
PORT=43127
TZ_DATA_DIR=/app/data
TZ_DATABASE_PATH=/app/data/tongzhuo-production.sqlite
TZ_LOG_DIR=/app/data/logs
TZ_BACKUP_DIR=/app/data/backups

# 推荐由部署平台以 secret 注入 32 字节主密钥（base64 或 64 位 hex）。
# 未设置时系统会在 TZ_DATA_DIR/secrets/master.key 创建仅本机可读的随机密钥。
TZ_MASTER_KEY=
TZ_COOKIE_SECURE=0
TZ_SESSION_HOURS=12
TZ_TRUST_PROXY=1

# 外部模型调用（TZ_AI_TIMEOUT_MS 等旧变量仍兼容）
TZ_AI_GENERATION_TIMEOUT_MS=90000
TZ_AI_GENERATION_MAX_RESPONSE_BYTES=2000000
TZ_AI_GENERATION_MAX_ATTEMPTS=2
# 单次请求内遇到繁忙、限流、超时或空响应时的受控重试
TZ_AI_UPSTREAM_MAX_ATTEMPTS=3
TZ_AI_UPSTREAM_RETRY_BASE_MS=800
TZ_AI_UPSTREAM_TOTAL_TIMEOUT_MS=55000
# 问题词包默认按 4 类一批、最多 2 批并行
TZ_AI_QUESTION_DIMENSIONS_PER_BATCH=4
TZ_AI_QUESTION_BATCH_CONCURRENCY=2

# 企业知识库与 RAG
# 可在后台新增 kind=embedding 的 OpenAI-compatible 供应商后填入该 ID。
# 未配置时使用本地 hash embedding + 关键词混合检索，建议生产环境配置正式 embedding 模型。
TZ_EMBEDDING_PROVIDER_ID=
TZ_EMBEDDING_TIMEOUT_MS=30000
TZ_RAG_LOCAL_FALLBACK=1

# 高级知识库能力（可选）
# OCR 服务需接受 {contentBase64,mimeType,sourceName}，返回 {text,confidence,blocks}。
# 未配置时扫描 PDF/无文字图片会明确失败，不会进入永久等待队列。
TZ_OCR_ENDPOINT=
TZ_OCR_API_KEY=
TZ_OCR_TIMEOUT_MS=60000
# 远程向量库需提供 /upsert、/query、/delete OpenAI 风格 JSON 接口；未配置时使用 SQLite
TZ_VECTOR_STORE_URL=
TZ_VECTOR_STORE_API_KEY=
TZ_VECTOR_STORE_COLLECTION=knowledge_chunks
TZ_VECTOR_STORE_REQUIRED=0
TZ_VECTOR_STORE_TIMEOUT_MS=30000
TZ_KNOWLEDGE_ASYNC_INDEX=0
TZ_KNOWLEDGE_ASYNC_INDEX_CHARS=100000

# 效果监测：远程网站诊断只允许这些 HTTP(S) 端口；服务器会拒绝本机、内网和保留地址。
TZ_MONITORING_REMOTE_PORTS=80,443
# 访问日志中的原始 IP 不落库，只保存 HMAC 摘要；未设置时复用 TZ_MASTER_KEY。
TZ_MONITORING_IP_SALT=

# 桐灼中央中转站（客户服务端使用实例签名调用；浏览器不会接触这些凭证）
# Leave blank until this private deployment is provisioned by the central
# platform. Production must use the central relay's HTTPS origin.
TZ_RELAY_BASE_URL=
TZ_RELAY_INSTANCE_ID=
TZ_RELAY_CLIENT_ID=
# Production Compose injects this as a Docker secret and rejects a direct
# TZ_RELAY_CLIENT_SECRET value. Local non-production development may set a
# direct value outside this template if needed; never put it in browser code.
TZ_RELAY_CLIENT_SECRET_FILE=
TZ_RELAY_DELIVERY_CONSUMER=
TZ_RELAY_TIMEOUT_MS=15000
TZ_RELAY_PULL_INTERVAL_MS=10000
TZ_RELAY_PULL_BATCH_SIZE=50
# Brand-monitoring plan scheduler. Each occurrence asks the relay for a fresh
# quote and is blocked if it exceeds the plan's approved per-run credit cap.
TZ_BRAND_MONITORING_SCHEDULER_INTERVAL_MS=60000
TZ_BRAND_MONITORING_SCHEDULER_BATCH_SIZE=12

# 内容资产自动巡检与引用状态。URL 每次成功检查后默认 24 小时再检查；
# 调度器每 6 小时领取到期地址，连续失败采用退避重试。
TZ_CONTENT_ASSET_PATROL_INTERVAL_MS=21600000
TZ_CONTENT_ASSET_PATROL_BATCH_SIZE=20
TZ_CONTENT_ASSET_CITATION_STALE_DAYS=30

# Optional: customer-server-only API for a controlled, isolated single-question
# diagnostic. Production Compose injects the token as a separate Docker
# secret. Keep it out of browser bundles/configuration and never reuse the
# relay client secret.
TZ_AD_HOC_DIAGNOSTIC_API_TOKEN_FILE=
