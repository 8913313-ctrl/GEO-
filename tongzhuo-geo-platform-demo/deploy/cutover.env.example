# Copy this file to deploy/cutover.env on the server.  Keep the real file out
# of version control. Application configuration remains in ../.env; Relay
# and optional ad-hoc credentials are file-backed Compose secrets below.

TZ_COMPOSE_PROJECT_NAME=tongzhuo-geo-production

# Use the customer deployment's absolute Linux website path in production.
TZ_SITE_STATIC_HOST_PATH=/opt/tongzhuo-geo/site
TZ_SITE_WORKSPACE_ID=default

# Staging must never occupy the live website port 19080.
TZ_STAGING_SITE_BIND_ADDRESS=127.0.0.1
TZ_STAGING_SITE_PORT=18182
TZ_STAGING_ADMIN_BIND_ADDRESS=127.0.0.1
TZ_STAGING_ADMIN_PORT=18183
TZ_STAGING_SITE_BASE_URL=http://127.0.0.1:18182
TZ_STAGING_DATA_VOLUME=tongzhuo-geo-staging-data

# The production public listener retains the old public port.  If Nginx owns
# the public port, change this to 127.0.0.1 and proxy to it from Nginx.
TZ_PRODUCTION_SITE_BIND_ADDRESS=0.0.0.0
TZ_PRODUCTION_SITE_PORT=19080
TZ_PRODUCTION_SITE_BASE_URL=https://www.example.invalid
TZ_PRODUCTION_ADMIN_BIND_ADDRESS=127.0.0.1
TZ_PRODUCTION_ADMIN_PORT=18183
TZ_ADMIN_TLS_CERT_HOST_PATH=/opt/tongzhuo-geo/certs
TZ_PRODUCTION_DATA_VOLUME=tongzhuo-geo-production-data
# Direct IP/port exposure must not trust client-supplied X-Forwarded-* headers.
# Change to 1 only when a trusted local reverse proxy is the sole public entry.
TZ_PRODUCTION_TRUST_PROXY=0
# Keep 1 for an HTTPS admin hostname.  Use 0 only for a temporary localhost
# tunnel without TLS, never for a public HTTP management endpoint.
TZ_PRODUCTION_COOKIE_SECURE=1

# Optional CDN/COS URL for the Windows publisher installer. Leave blank to
# serve the local /downloads fallback from geo-admin.
TZ_PUBLISHER_DOWNLOAD_URL=

# Leave both paths blank until the private instance is provisioned. Production
# Compose reads only these protected host files as Docker secrets; never put
# their values in ../.env or an environment variable.
TZ_RELAY_CLIENT_SECRET_HOST_PATH=
TZ_AD_HOC_DIAGNOSTIC_API_TOKEN_HOST_PATH=
