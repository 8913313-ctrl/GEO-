# 桐灼 GEO Docker Compose 生产入口配置（模板）
# 安装前必须把 example.invalid 替换为客户正式官网地址。

TZ_COMPOSE_PROJECT_NAME=tongzhuo-geo-production
TZ_TENANT_ID=tenant_example_company
TZ_PROJECT_ID=example-company
TZ_INDUSTRY_TEMPLATE=professional-services
TZ_PROJECT_SEED=
# 仅供本地开发显式开启；生产环境即使误设为 true 也会拒绝演示内容。
TZ_SITE_FRONTEND_DEMO=false
TZ_SITE_STATIC_HOST_PATH=/opt/tongzhuo-geo/site

# 官网如由宿主机 Nginx/Caddy 终止 HTTPS，建议只绑定 127.0.0.1。
TZ_PRODUCTION_SITE_BIND_ADDRESS=0.0.0.0
TZ_PRODUCTION_SITE_PORT=18080
TZ_PRODUCTION_SITE_BASE_URL=https://www.example.invalid

# 后台默认只绑定回环 HTTPS，禁止直接暴露公网明文 HTTP。
TZ_PRODUCTION_ADMIN_BIND_ADDRESS=127.0.0.1
TZ_PRODUCTION_ADMIN_PORT=18183
TZ_ADMIN_TLS_CERT_HOST_PATH=/opt/tongzhuo-geo/certs
TZ_PRODUCTION_DATA_VOLUME=tongzhuo-geo-production-data

# 只有可信本机反向代理是唯一入口时才改为 1。
TZ_PRODUCTION_TRUST_PROXY=0
TZ_PRODUCTION_COOKIE_SECURE=1

# Leave both paths blank for a customer not connected to the central relay.
# After provisioning, point each enabled capability at an absolute, regular
# host file with no group/other permissions. Compose mounts it only into
# geo-admin at /run/secrets; its contents never belong in app.env.
# TZ_RELAY_CLIENT_SECRET_HOST_PATH=/opt/tongzhuo-geo/shared/relay-inputs/relay-client-secret
TZ_RELAY_CLIENT_SECRET_HOST_PATH=
# Optional and disabled by default. This must be a different value/file from
# the relay HMAC secret.
# TZ_AD_HOC_DIAGNOSTIC_API_TOKEN_HOST_PATH=/opt/tongzhuo-geo/shared/relay-inputs/ad-hoc-diagnostic-api-token
TZ_AD_HOC_DIAGNOSTIC_API_TOKEN_HOST_PATH=
