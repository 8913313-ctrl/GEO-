# Tongzhuo GEO private-delivery application configuration template.
# The installer writes the completed file to /opt/tongzhuo-geo/shared/app.env.
# Do not commit a populated file or put production credentials in this template.
NODE_ENV=production
TZ_BIND_HOST=0.0.0.0
PORT=43127
TZ_DATA_DIR=/app/data
TZ_DATABASE_PATH=/app/data/tongzhuo-production.sqlite
TZ_LOG_DIR=/app/data/logs
TZ_BACKUP_DIR=/app/data/backups

# Leave blank to generate and persist a random 32-byte key in the protected
# data volume. Alternatively inject a 32-byte base64 or 64-hex key.
TZ_MASTER_KEY=
TZ_COOKIE_SECURE=1
TZ_SESSION_HOURS=12
TZ_TRUST_PROXY=0

TZ_AI_TIMEOUT_MS=90000
TZ_AI_MAX_RESPONSE_BYTES=2000000
TZ_AI_MAX_ATTEMPTS=2

TZ_EMBEDDING_PROVIDER_ID=
TZ_EMBEDDING_TIMEOUT_MS=30000
TZ_RAG_LOCAL_FALLBACK=1

TZ_OCR_ENDPOINT=
TZ_OCR_API_KEY=
TZ_OCR_TIMEOUT_MS=60000
TZ_VECTOR_STORE_URL=
TZ_VECTOR_STORE_API_KEY=
TZ_VECTOR_STORE_COLLECTION=knowledge_chunks
TZ_VECTOR_STORE_REQUIRED=0
TZ_VECTOR_STORE_TIMEOUT_MS=30000
TZ_KNOWLEDGE_ASYNC_INDEX=0
TZ_KNOWLEDGE_ASYNC_INDEX_CHARS=100000

# Only allow the public ports used by this customer's official site. Add a
# non-standard public port such as 18080 deliberately; never add an intranet
# or administrative port.
TZ_MONITORING_REMOTE_PORTS=80,443
TZ_MONITORING_IP_SALT=

# Central Tongzhuo AI-effect relay. The central operator issues one credential
# set per private instance. Set all three identity values together; leaving
# them blank disables the relay.
#
# Never put TZ_RELAY_CLIENT_SECRET in this file. Production Compose injects
# TZ_RELAY_CLIENT_SECRET_FILE from a protected host file as a Docker secret.
# Set TZ_RELAY_CLIENT_SECRET_HOST_PATH only in shared/cutover.env after the
# instance has been provisioned; see PRIVATE-DELIVERY.md.
TZ_RELAY_BASE_URL=
TZ_RELAY_INSTANCE_ID=
TZ_RELAY_CLIENT_ID=
TZ_RELAY_DELIVERY_CONSUMER=
TZ_RELAY_TIMEOUT_MS=15000
TZ_RELAY_PULL_INTERVAL_MS=10000
TZ_RELAY_PULL_BATCH_SIZE=50
TZ_BRAND_MONITORING_SCHEDULER_INTERVAL_MS=60000
TZ_BRAND_MONITORING_SCHEDULER_BATCH_SIZE=12

# Optional customer-server-only endpoint for one temporary question. It is
# disabled unless its separate Compose secret source is configured. Never
# reuse the relay HMAC secret and never put either token in app.env.
